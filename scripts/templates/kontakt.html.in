<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta name="robots" content="index, follow, max-image-preview:large">

    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/kontakt.css">

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "LTS Market",
        "url": "https://ltsmarket.pl/",
        "email": "sales@ltsmarket.pl",
        "telephone": "+48 575 254 431",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Rybacka 7",
          "addressLocality": "Wrocław",
          "addressCountry": "PL"
        }
      }
    </script>

<title>Kontakt | LTS Market Wrocław</title>
<meta name="description" content="Skontaktuj się z LTS Market we Wrocławiu. Profesjonalne urządzenia dla branży beauty, sprzedaż nowych i używanych urządzeń oraz leasing. Rybacka 7, Wrocław.">

</head>

  <body>
    <a class="skip-link" href="#main-content"> Przejdź do treści </a>

    <!-- SITE_HEADER -->

    <main id="main-content">

      <section class="contact-hero">
        <div class="container contact-hero__grid">
          <div class="contact-hero__content">
            <p class="section-label contact-hero__label">Kontakt</p>

            <h1 class="contact-hero__title">
              Porozmawiajmy
              <span>o Twoim urządzeniu</span>
            </h1>

            <p class="contact-hero__description">
              Szukasz nowego urządzenia, sprzętu używanego albo chcesz sprawdzić
              możliwości leasingu? Skontaktuj się z nami.
            </p>
          </div>

          <div class="contact-hero__details">
            <a class="contact-detail" href="tel:+48575254431">
              <span class="contact-detail__label"> Telefon </span>

              <strong> +48 575 254 431 </strong>

              <span class="contact-detail__arrow" aria-hidden="true"> → </span>
            </a>

            <a class="contact-detail" href="mailto:sales@ltsmarket.pl">
              <span class="contact-detail__label"> E-mail </span>

              <strong> sales@ltsmarket.pl </strong>

              <span class="contact-detail__arrow" aria-hidden="true"> → </span>
            </a>

            <a class="contact-detail" href="#mapa">
              <span class="contact-detail__label"> Adres </span>

              <strong> Rybacka 7, Wrocław </strong>

              <span class="contact-detail__arrow" aria-hidden="true"> ↓ </span>
            </a>
          </div>
        </div>
      </section>

      <section class="contact-form-section">
        <div class="container contact-form-section__grid">
          <div class="contact-form-section__intro">
            <p class="section-label">Zapytaj o ofertę</p>

            <h2 class="contact-section-title">
              Napisz do nas.
              <span>Odezwiemy się.</span>
            </h2>

            <p>
              Opisz krótko, czego szukasz. Możesz zapytać o konkretne
              urządzenie, dostępność sprzętu używanego, leasing lub po prostu
              poprosić o pomoc w wyborze.
            </p>
          </div>

          <div class="contact-form-wrapper">
            <form class="contact-form" id="contact-form" novalidate>
              <input type="hidden" name="formType" value="contact">

              <input type="hidden" name="page" value="kontakt">

              <div class="contact-form__field">
                <label for="contact-name">
                  Imię i nazwisko <span>*</span>
                </label>

                <input type="text" id="contact-name" name="name" autocomplete="name" placeholder="Jan Kowalski" required>
              </div>

              <div class="contact-form__row">
                <div class="contact-form__field">
                  <label for="contact-phone"> Telefon <span>*</span> </label>

                  <input type="tel" id="contact-phone" name="phone" autocomplete="tel" placeholder="+48 000 000 000" required>
                </div>

                <div class="contact-form__field">
                  <label for="contact-email"> E-mail </label>

                  <input type="email" id="contact-email" name="email" autocomplete="email" placeholder="email@firma.pl">
                </div>
              </div>

              <div class="contact-form__field">
                <label for="contact-subject"> Czego dotyczy zapytanie? </label>

                <select id="contact-subject" name="equipment">
                  <option value="">Wybierz</option>

                  <option value="nowe-urzadzenie">Nowe urządzenie</option>

                  <option value="uzywane-urzadzenie">Używane urządzenie</option>

                  <option value="leasing">Leasing</option>

                  <option value="konkretne-urzadzenie">
                    Konkretne urządzenie
                  </option>

                  <option value="doradztwo">Pomoc w wyborze urządzenia</option>

                  <option value="inne">Inne</option>
                </select>
              </div>

              <div class="contact-form__field">
                <label for="contact-message"> Wiadomość </label>

                <textarea id="contact-message" name="message" rows="6" placeholder="Napisz, jakiego urządzenia szukasz lub w czym możemy pomóc."></textarea>
              </div>

              <label class="contact-form__consent">
                <input type="checkbox" id="contact-consent" name="consent" value="accepted" required>

                <span>
                  Wyrażam zgodę na kontakt w sprawie przesłanego zapytania i
                  zapoznałem/am się z informacjami dotyczącymi
                  <a href="/polityka-prywatnosci.html"> prywatności </a>.
                  <strong>*</strong>
                </span>
              </label>

              <div class="contact-form__footer">
                <button class="button button--primary" type="submit">
                  Wyślij zapytanie
                </button>

                <p class="contact-form__required">* Pola wymagane</p>
              </div>

              <div class="contact-form__status" id="contact-form-status" role="status" aria-live="polite" hidden></div>
            </form>
          </div>
        </div>
      </section>

      <section class="contact-page-map" id="mapa">
        <div class="container">
          <div class="contact-page-map__heading">
            <div>
              <p class="section-label">Wrocław</p>

              <h2>Rybacka 7</h2>
            </div>

            <div class="contact-page-map__address">
              <span> LTS Market </span>

              <strong> Rybacka 7, Wrocław </strong>
            </div>
          </div>

          <div class="contact-page-map__frame">
            <iframe src="https://www.google.com/maps?q=Rybacka%207%2C%20Wroc%C5%82aw%2C%20Poland&amp;output=embed" title="LTS Market — Rybacka 7, Wrocław" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
          </div>
        </div>
      </section>
    </main>

    <!-- SITE_FOOTER -->

    <script src="/js/main.js" defer></script>
    <script src="/js/kontakt.js" defer></script>
  <script src="/js/privacy.js" defer></script></body>
</html>
