<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta name="robots" content="index, follow, max-image-preview:large">

    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/nowe.css">

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "ItemList",
        "name": "Nowe lasery do epilacji - LTS Market",
        "numberOfItems": 4,
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "item": {
              "@type": "Product",
              "name": "Alpha Mini",
              "url": "https://ltsmarket.pl/nowe.html#alpha-mini"
            }
          },
          {
            "@type": "ListItem",
            "position": 2,
            "item": {
              "@type": "Product",
              "name": "Ray",
              "url": "https://ltsmarket.pl/nowe.html#ray"
            }
          },
          {
            "@type": "ListItem",
            "position": 3,
            "item": {
              "@type": "Product",
              "name": "Alpha",
              "url": "https://ltsmarket.pl/nowe.html#alpha"
            }
          },
          {
            "@type": "ListItem",
            "position": 4,
            "item": {
              "@type": "Product",
              "name": "Lumos",
              "url": "https://ltsmarket.pl/nowe.html#lumos"
            }
          }
        ]
      }
    </script>

<title>Nowe lasery do epilacji dla gabinetów | LTS Market</title>
<meta name="description" content="Nowe profesjonalne lasery do epilacji: Alpha Mini, Ray, Alpha i Lumos. Sprzedaż, leasing, szkolenie i wsparcie serwisowe LTS Market w całej Polsce.">

</head>

  <body>
    <a class="skip-link" href="#main-content"> Przejdź do treści </a>

    <!-- SITE_HEADER -->

    <main id="main-content">

      <section class="nowe-hero">
        <div class="container nowe-hero__container">
          <div class="nowe-hero__content">
            <p class="section-label nowe-hero__label">Nowe urządzenia</p>

            <h1 class="nowe-hero__title">
              Lasery do epilacji
              <span>dla profesjonalnych gabinetów</span>
            </h1>

            <p class="nowe-hero__description">
              Wybierz urządzenie dopasowane do wielkości gabinetu, liczby
              klientów i planowanego zakresu zabiegów. Od kompaktowego Alpha
              Mini po zaawansowany system Lumos.
            </p>

            <div class="nowe-hero__actions">
              <a class="button button--primary" href="#modele">
                Zobacz modele
              </a>

              <a class="button button--outline-light" href="/kontakt.html">
                Porozmawiaj z doradcą
              </a>
            </div>

            <div class="nowe-hero__stats">
              <div class="nowe-hero__stat">
                <strong>4</strong>
                <span>modele</span>
              </div>

              <div class="nowe-hero__stat">
                <strong>1000–4000 W</strong>
                <span>dostępne moce</span>
              </div>

              <div class="nowe-hero__stat">
                <strong>Polska</strong>
                <span>sprzedaż i wsparcie</span>
              </div>
            </div>
          </div>

          <div class="nowe-hero__visual">
            <img src="/assets/img/nowe/lumos.webp" alt="Laser Lumos" width="900" height="900" fetchpriority="high">

            <div class="nowe-hero__product-info">
              <span>Model premium</span>
              <strong>Lumos</strong>
              <small>2000–4000 W</small>
            </div>
          </div>
        </div>
      </section>

      <section class="nowe-intro">
        <div class="container nowe-intro__grid">
          <div>
            <p class="section-label">Profesjonalne technologie</p>

            <h2 class="nowe-section-title">
              Urządzenia dopasowane
              <span>do Twojego biznesu</span>
            </h2>
          </div>

          <div class="nowe-intro__copy">
            <p>
              Wybór lasera powinien uwzględniać nie tylko moc, ale również
              liczbę klientów, tempo pracy gabinetu, ergonomię głowicy i
              dostępne technologie.
            </p>

            <p>
              Pomagamy dobrać urządzenie do realnych potrzeb gabinetu oraz
              planowanego budżetu.
            </p>
          </div>
        </div>
      </section>

      <section class="nowe-products" id="modele">
        <div class="container">
          <div class="nowe-heading">
            <p class="section-label">Oferta</p>

            <h2 class="nowe-section-title">
              Wybierz
              <span>swój laser</span>
            </h2>

            <p class="nowe-heading__copy">
              Cztery modele dla gabinetów o różnej skali działalności.
            </p>
          </div>

          <div class="nowe-products__list">

            <article class="nowe-product" id="alpha-mini">
              <div class="nowe-product__visual">
                <span class="nowe-product__badge"> Start </span>

                <img src="/assets/img/nowe/alpha-mini.webp" alt="Alpha Mini" width="760" height="760" loading="lazy">
              </div>

              <div class="nowe-product__content">
                <div class="nowe-product__heading">
                  <div>
                    <span class="nowe-product__type"> Laser diodowy </span>

                    <h3>Alpha Mini</h3>
                  </div>

                  <div class="nowe-product__price">
                    <span>od</span>
                    <strong>40 000 zł</strong>
                  </div>
                </div>

                <p class="nowe-product__lead">
                  Kompaktowy model przeznaczony do rozpoczęcia działalności oraz
                  pracy przy umiarkowanym obciążeniu gabinetu.
                </p>

                <div class="nowe-specs">
                  <div>
                    <span>Moc głowicy</span>
                    <strong>1000–1200 W</strong>
                  </div>

                  <div>
                    <span>Energia</span>
                    <strong>120–140 J / 200 ms</strong>
                  </div>

                  <div>
                    <span>Okno zabiegowe</span>
                    <strong>12 × 12 mm</strong>
                  </div>

                  <div>
                    <span>Chłodzenie</span>
                    <strong>TEC 500 W</strong>
                  </div>
                </div>

                <ul class="nowe-features">
                  <li>Dotykowy ekran głowicy</li>
                  <li>System ICE Flow</li>
                  <li>Waga poniżej 35 kg</li>
                  <li>1–4 wiązki</li>
                  <li>Kompaktowa konstrukcja</li>
                </ul>

                <div class="nowe-product__actions">
                  <a class="button button--primary" href="/kontakt.html">
                    Zapytaj o Alpha Mini
                  </a>
                </div>
              </div>
            </article>

            <article class="nowe-product nowe-product--reverse" id="ray">
              <div class="nowe-product__visual">
                <span class="nowe-product__badge"> Compact </span>

                <img src="/assets/img/nowe/ray.webp" alt="Ray" width="760" height="760" loading="lazy">
              </div>

              <div class="nowe-product__content">
                <div class="nowe-product__heading">
                  <div>
                    <span class="nowe-product__type"> Laser diodowy </span>

                    <h3>Ray</h3>
                  </div>

                  <div class="nowe-product__price">
                    <strong>55 000 zł</strong>
                  </div>
                </div>

                <p class="nowe-product__lead">
                  Model wyposażony w cztery wymienne końcówki, przygotowany do
                  wygodnej pracy na różnych obszarach ciała.
                </p>

                <div class="nowe-specs">
                  <div>
                    <span>Moc głowicy</span>
                    <strong>1200 W</strong>
                  </div>

                  <div>
                    <span>Energia</span>
                    <strong>150 J / 200 ms</strong>
                  </div>

                  <div>
                    <span>Końcówki</span>
                    <strong>4 wymienne</strong>
                  </div>

                  <div>
                    <span>Chłodzenie</span>
                    <strong>Freon 300 W</strong>
                  </div>
                </div>

                <ul class="nowe-features">
                  <li>4 wymienne końcówki</li>
                  <li>Technologia FAC</li>
                  <li>Stos diodowy 12 bar</li>
                  <li>Dotykowy ekran głowicy</li>
                  <li>Ergonomiczna głowica</li>
                </ul>

                <div class="nowe-product__actions">
                  <a class="button button--primary" href="/kontakt.html">
                    Zapytaj o Ray
                  </a>
                </div>
              </div>
            </article>

            <article class="nowe-product" id="alpha">
              <div class="nowe-product__visual">
                <span class="nowe-product__badge"> Business </span>

                <img src="/assets/img/nowe/alpha.webp" alt="Alpha" width="760" height="760" loading="lazy">
              </div>

              <div class="nowe-product__content">
                <div class="nowe-product__heading">
                  <div>
                    <span class="nowe-product__type"> Laser diodowy </span>

                    <h3>Alpha</h3>
                  </div>

                  <div class="nowe-product__price">
                    <span>od</span>
                    <strong>60 000 zł</strong>
                  </div>
                </div>

                <p class="nowe-product__lead">
                  Wysoka moc i rozbudowane funkcje dla gabinetów potrzebujących
                  urządzenia przygotowanego do intensywnej pracy.
                </p>

                <div class="nowe-specs">
                  <div>
                    <span>Moc głowicy</span>
                    <strong>1600–2000 W</strong>
                  </div>

                  <div>
                    <span>Energia</span>
                    <strong>180–220 J / 200 ms</strong>
                  </div>

                  <div>
                    <span>Okno zabiegowe</span>
                    <strong>12 × 20 mm</strong>
                  </div>

                  <div>
                    <span>Chłodzenie</span>
                    <strong>TEC 1200 W</strong>
                  </div>
                </div>

                <ul class="nowe-features">
                  <li>Wbudowany dermaskop</li>
                  <li>System CRM</li>
                  <li>System Android</li>
                  <li>Automatyczny dobór parametrów</li>
                  <li>Technologia FAC</li>
                </ul>

                <div class="nowe-product__actions">
                  <a class="button button--primary" href="/kontakt.html">
                    Zapytaj o Alpha
                  </a>
                </div>
              </div>
            </article>

            <article class="nowe-product nowe-product--reverse nowe-product--premium" id="lumos">
              <div class="nowe-product__visual">
                <span class="nowe-product__badge"> Premium </span>

                <img src="/assets/img/nowe/lumos.webp" alt="Lumos" width="760" height="760" loading="lazy">
              </div>

              <div class="nowe-product__content">
                <div class="nowe-product__heading">
                  <div>
                    <span class="nowe-product__type">
                      4-wiązkowy laser diodowy
                    </span>

                    <h3>Lumos</h3>
                  </div>

                  <div class="nowe-product__price">
                    <strong>68 000–100 000 zł</strong>
                  </div>
                </div>

                <p class="nowe-product__lead">
                  Zaawansowany system łączący wysoką moc, cztery długości fal i
                  rozbudowane technologie wspierające pracę gabinetu.
                </p>

                <div class="nowe-specs">
                  <div>
                    <span>Moc głowicy</span>
                    <strong>2000–4000 W</strong>
                  </div>

                  <div>
                    <span>Długości fal</span>
                    <strong>755 / 808 / 940 / 1064 nm</strong>
                  </div>

                  <div>
                    <span>Energia</span>
                    <strong>10–240 J</strong>
                  </div>

                  <div>
                    <span>Częstotliwość</span>
                    <strong>1–30 Hz</strong>
                  </div>
                </div>

                <ul class="nowe-features">
                  <li>4 długości fal</li>
                  <li>Impuls od 5 ms</li>
                  <li>NeoDez</li>
                  <li>Dermaskop</li>
                  <li>CRM</li>
                  <li>Android</li>
                  <li>ICE Flow</li>
                  <li>FAC</li>
                </ul>

                <div class="nowe-product__actions">
                  <a class="button button--primary" href="/kontakt.html">
                    Zapytaj o Lumos
                  </a>
                </div>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section class="nowe-support">
        <div class="container">
          <div class="nowe-heading nowe-heading--dark">
            <p class="section-label">Więcej niż urządzenie</p>

            <h2 class="nowe-section-title">
              Zaplecze dla
              <span>Twojego biznesu</span>
            </h2>
          </div>

          <div class="nowe-support__grid">
            <article class="nowe-support__card">
              <div class="nowe-support__icon" aria-hidden="true">
                <svg viewbox="0 0 48 48">
                  <path d="M24 4L39 10V21C39 31.5 33 39.5 24 44C15 39.5 9 31.5 9 21V10L24 4Z">
                  <path d="M17 24L22 29L32 18">
                </svg>
              </div>

              <h3>Gwarancja producenta</h3>

              <p>
                Nowe urządzenia objęte są gwarancją producenta zgodnie z
                warunkami wybranego modelu.
              </p>
            </article>

            <article class="nowe-support__card">
              <div class="nowe-support__icon" aria-hidden="true">
                <svg viewbox="0 0 48 48">
                  <path d="M30.5 8.5C27.5 5.5 23 4.5 19 6L26 13L19 20L12 13C10.5 17 11.5 21.5 14.5 24.5C17.5 27.5 22 28.5 26 27L39 40">
                  <path d="M20 28L7 41">
                </svg>
              </div>

              <h3>Własny serwis</h3>

              <p>
                Zaplecze Laser Tech Service we Wrocławiu oraz obsługa serwisowa
                klientów na terenie Polski.
              </p>
            </article>

            <article class="nowe-support__card">
              <div class="nowe-support__icon" aria-hidden="true">
                <svg viewbox="0 0 48 48">
                  <path d="M4 17L24 7L44 17L24 27L4 17Z">
                  <path d="M12 21V31C12 35 17.5 39 24 39C30.5 39 36 35 36 31V21">
                  <path d="M44 17V31">
                </svg>
              </div>

              <h3>Szkolenie</h3>

              <p>
                Pomagamy przygotować personel do prawidłowej i świadomej pracy z
                zakupionym urządzeniem.
              </p>
            </article>

            <article class="nowe-support__card">
              <div class="nowe-support__icon" aria-hidden="true">
                <svg viewbox="0 0 48 48">
                  <path d="M8 25V22C8 13.2 15.2 6 24 6C32.8 6 40 13.2 40 22V25">
                  <path d="M8 24H12C14.2 24 16 25.8 16 28V34C16 36.2 14.2 38 12 38H10C8.9 38 8 37.1 8 36V24Z">
                  <path d="M40 24H36C33.8 24 32 25.8 32 28V34C32 36.2 33.8 38 36 38H40V24Z">
                  <path d="M40 36C40 40 36 42 31 42H27">
                </svg>
              </div>

              <h3>Wsparcie po sprzedaży</h3>

              <p>
                Pozostajemy dostępni również po wdrożeniu urządzenia w Twoim
                gabinecie.
              </p>
            </article>
          </div>
        </div>
      </section>

      <section class="nowe-financing">
        <div class="container nowe-financing__grid">
          <div>
            <p class="section-label">Finansowanie</p>

            <h2 class="nowe-section-title">
              Nowe urządzenie
              <span>bez zamrażania kapitału</span>
            </h2>

            <p class="nowe-financing__copy">
              Dla każdego klienta przygotowujemy indywidualną ofertę leasingu na
              zakup nowego urządzenia. Finansowanie dobieramy do wartości
              sprzętu, możliwości firmy oraz planowanego okresu leasingu.
            </p>

            <p class="nowe-financing__copy">
              Współpracujemy z bankami i firmami leasingowymi działającymi na
              terenie całej Polski.
            </p>

            <a class="button button--primary" href="/leasing.html">
              Sprawdź możliwości finansowania
            </a>
          </div>
          </div>
        </div>
      </section>

      <section class="nowe-cta">
        <div class="container nowe-cta__grid">
          <div>
            <p class="section-label">Kontakt</p>

            <h2>
              Nie wiesz,
              <span>który model wybrać?</span>
            </h2>

            <p>
              Powiedz nam, czego potrzebujesz. Pomożemy porównać urządzenia i
              dobrać odpowiedni model.
            </p>
          </div>

          <div class="nowe-cta__actions">
            <a class="button button--primary" href="/kontakt.html">
              Zapytaj o ofertę
            </a>

            <a class="nowe-cta__contact" href="tel:+48575254431">
              <span>Telefon</span>
              <strong>+48 575 254 431</strong>
            </a>

            <a class="nowe-cta__contact" href="mailto:sales@ltsmarket.pl">
              <span>E-mail</span>
              <strong>sales@ltsmarket.pl</strong>
            </a>
          </div>
        </div>
      </section>
    </main>

    <!-- SITE_FOOTER -->

    <script src="/js/main.js" defer></script>
  <script src="/js/privacy.js" defer></script></body>
</html>
